# SBP AirCare — run aircare-backup.service every night at 03:15 Bangkok time (whatever the server's own time zone is).
# Persistent=true: a night missed while the server was off runs at the next boot.
#   sudo systemctl enable --now aircare-backup.timer · next run: systemctl list-timers aircare-backup.timer
[Unit]
Description=SBP AirCare nightly backup at 03:15 (Asia/Bangkok)

[Timer]
OnCalendar=*-*-* 03:15:00 Asia/Bangkok
Persistent=true
AccuracySec=1min
Unit=aircare-backup.service

[Install]
WantedBy=timers.target
