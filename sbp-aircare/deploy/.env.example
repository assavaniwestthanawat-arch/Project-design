# SBP AirCare — ค่าตั้งเว็บไซต์ (Rev.10) · ทุกตัวแปรที่ server/config.mjs อ่าน + ค่าของ Caddy และสคริปต์สำรองข้อมูล
# Docker: คัดลอกเป็น deploy/.env · Ubuntu + systemd: คัดลอกเป็น /etc/aircare/aircare.env — วิธีกรอกอยู่ใน deploy/DEPLOY_TH.md
# รูปแบบ: ชื่อ=ค่า บรรทัดละตัว · คอมเมนต์ต้องอยู่บรรทัดของตัวเอง (ห้ามต่อท้ายค่า) · ไม่ต้องใส่เครื่องหมายคำพูด · ห้ามมี $ ในค่า
# ค่าที่เว้นว่างไว้ = ใช้ค่าเริ่มต้นหรือปิดความสามารถนั้น · ห้ามนำไฟล์ที่กรอกรหัสจริงแล้วขึ้น git หรือส่งในแชต

# ── เว็บไซต์ ───────────────────────────────────────────────────────────────────
# production = โหมดใช้งานจริง (ตรวจค่าก่อนเปิด ถ้าค่าไม่ปลอดภัยเว็บจะไม่ยอมเริ่ม) · Docker กำหนดให้เองใน compose.yaml
NODE_ENV=production
# ที่อยู่เว็บจริง ต้องขึ้นต้นด้วย https:// ไม่มี / ท้าย (ใช้ในลิงก์อีเมล ลิงก์ตรวจสถานะ และ sitemap)
SITE_URL=https://example.co.th
# ชื่อโดเมนอย่างเดียว (ไม่มี https://) ให้ Caddy ขอใบรับรอง HTTPS — ต้องตรงกับ SITE_URL
SITE_DOMAIN=example.co.th
# อีเมลผู้ดูแลที่ Let's Encrypt ใช้แจ้งเรื่องใบรับรอง HTTPS
ACME_EMAIL=it@example.co.th
# แบบที่เป็นหน้าแรก: a b c d a2 b2 c2 d2 a3 b3 c3 + .html (ค่าเริ่มต้น c.html — รอเจ้าของเลือก)
HOME_PAGE=c.html
# แบบอื่นที่ยังเปิดดูได้ (ไม่ให้ Google เก็บ) คั่นด้วย , · เว้นว่าง = เปิดทั้ง 11 แบบ · ตอนเปิดจริงใส่เฉพาะแบบที่เลือก
PUBLIC_PAGES=
# beta = มีแถบ Beta ฟอร์มความเห็น ปุ่มสลับแบบ (ช่วงทดลอง) · live = ซ่อนทั้งหมดและใช้ชื่อหน้าสำหรับลูกค้า (เปิดจริง)
SITE_MODE=beta
# ที่อยู่ที่โปรแกรมรอรับ: 127.0.0.1 = รับเฉพาะ Caddy ในเครื่องเดียวกัน (Docker ใช้ 0.0.0.0 ให้เอง)
HOST=127.0.0.1
# พอร์ตของโปรแกรม (Caddy ส่งต่อมาที่พอร์ตนี้)
PORT=8080
# 1 = เชื่อที่อยู่ IP จริงที่ Caddy ส่งมา (ต้องเป็น 1 เมื่ออยู่หลัง Caddy และห้ามเปิดพอร์ตโปรแกรมสู่ภายนอก)
TRUST_PROXY=1

# ── ข้อมูลและการสำรอง ──────────────────────────────────────────────────────────
# โฟลเดอร์ฐานข้อมูลและสำเนา (Ubuntu: /var/lib/aircare · Docker ใช้ /data ให้เอง)
DATA_DIR=/var/lib/aircare
# ไฟล์ฐานข้อมูล · เว้นว่าง = DATA_DIR/aircare.sqlite
DB_FILE=
# โฟลเดอร์สำเนาในเครื่อง · เว้นว่าง = DATA_DIR/backups
BACKUP_DIR=
# จำนวนสำเนาล่าสุดที่เก็บในเครื่อง (สำเนาเก่ากว่านั้นถูกลบเอง)
BACKUP_KEEP=30
# เวลาสำรองในตัวโปรแกรมทุกคืน (เวลาไทย ชั่วโมง:นาที) · เว้นว่าง = ไม่สำรองในตัว
BACKUP_AT=03:00
# ลบข้อมูลส่วนบุคคลของคำขอที่จบแล้วและเก่ากว่า N วัน (มีรายการเงิน = เก็บอย่างน้อย 5 ปี · ยอดเงินและเลขใบเสร็จไม่ถูกลบ) · ทำวันละครั้งหลัง 03:30 น. · 0 = ไม่ลบ — รอเจ้าของกำหนดกับที่ปรึกษากฎหมาย
RETENTION_DAYS=0
# ปลายทางสำเนานอกเครื่องของ rclone เช่น r2:sbp-aircare-backup/db · เว้นว่าง = ยังไม่มีสำเนานอกเครื่อง
RCLONE_REMOTE=
# ไฟล์ตั้งค่า rclone (รหัสเข้าที่เก็บไฟล์บนคลาวด์ ไม่ใส่ในไฟล์นี้)
RCLONE_CONFIG=/etc/aircare/rclone.conf
# เก็บสำเนานอกเครื่องย้อนหลังกี่วัน (สำเนาล่าสุด 7 ชุดไม่ถูกลบเสมอ)
OFFSITE_KEEP_DAYS=30
# ลิงก์ ping ของ Healthchecks.io ให้แจ้งเตือนเมื่อสำรองข้อมูลคืนไหนไม่สำเร็จ · เว้นว่าง = ไม่ใช้
HC_PING_URL=

# ── เจ้าหน้าที่และคิวงาน ──────────────────────────────────────────────────────────
# รหัสเจ้าหน้าที่แบบใช้ร่วมกันของระบบเดิม · แนะนำเว้นว่างแล้วใช้บัญชีรายคน (ถ้าใส่ต้องยาวอย่างน้อย 24 ตัว)
STAFF_TOKEN=
# รายชื่อทีมในหน้าหลังบ้าน (JSON) · เว้นว่าง = ["ทีม 1","ทีม 2","ผู้รับเหมา"]
TEAMS=
# จำนวนงานต่อครึ่งวัน (เช้า/บ่าย) ที่แถบวันว่างใช้ — ให้เจ้าของหรือหัวหน้าช่างกำหนด
SLOT_CAPACITY=2
# (รหัสผ่านบัญชีเจ้าหน้าที่ตั้งด้วยคำสั่ง deploy/aircare-cli.sh staff add — ห้ามเขียนรหัสผ่านในไฟล์นี้)

# ── การแจ้งเตือน ─────────────────────────────────────────────────────────────────
# อีเมลทีมที่รับแจ้งคำขอใหม่และการชำระเงิน คั่นหลายอีเมลด้วย ,
NOTIFY_EMAIL=
# 1 = ส่งอีเมลรับเรื่องถึงลูกค้าที่กรอกอีเมล (ไม่ระบุเวลาตอบกลับ) · 0 = ไม่ส่ง
CUSTOMER_ACK=0
# 1 = ส่งอีเมลถึงลูกค้าเมื่อสถานะ/วันนัดเปลี่ยน มีรายการชำระเงิน หรือบริษัทยืนยันรับเงินแล้ว · 0 = ไม่ส่ง
CUSTOMER_NOTIFY=0
# เซิร์ฟเวอร์ส่งอีเมล: smtp.gmail.com สำหรับ Gmail · เว้นว่าง = ไม่ส่งอีเมล (ใส่เมื่อได้ App Password แล้ว)
SMTP_HOST=
# พอร์ต: 465 = เข้ารหัสตั้งแต่ต้น (แนะนำสำหรับ Gmail) · 587 = STARTTLS
SMTP_PORT=465
# 1 = เข้ารหัสตั้งแต่ต้น · เว้นว่าง = เลือกเอง (พอร์ต 465 = 1)
SMTP_SECURE=
# บัญชี Gmail ของบริษัทที่ใช้ส่ง
SMTP_USER=
# App Password 16 ตัวของบัญชีนั้น (พิมพ์ติดกันไม่มีเว้นวรรค) — ไม่ใช่รหัสผ่านปกติ
SMTP_PASS=
# ชื่อและอีเมลผู้ส่งที่ลูกค้าเห็น เช่น SBP AirCare <service@example.co.th> · เว้นว่าง = SMTP_USER
MAIL_FROM=
# วิธีส่ง: smtp / none · เว้นว่าง = smtp เมื่อมี SMTP_HOST (memory ใช้บนเครื่องนักพัฒนาเท่านั้น)
MAIL_TRANSPORT=
# Channel access token (long-lived) ของ LINE Messaging API · เว้นว่าง = ไม่แจ้งทาง LINE
LINE_TOKEN=
# User ID (ขึ้นต้นด้วย U) ของผู้รับแจ้งทาง LINE — ต้องเพิ่ม LINE OA ของบริษัทเป็นเพื่อนก่อน
LINE_TO=

# ── การชำระเงิน (เฟส 1 ไม่ต้องมีผู้ให้บริการรับชำระ) ────────────────────────────────────
# พร้อมเพย์ของบริษัท = เลขประจำตัวผู้เสียภาษีนิติบุคคล 13 หลักที่ผูกพร้อมเพย์กับธนาคารแล้ว · เว้นว่าง = ไม่แสดง QR
PROMPTPAY_ID=
# ชื่อผู้รับเงินที่ลูกค้าเห็น
PAYEE_NAME=บริษัท สหบูรพากรุ๊ป จำกัด
# ชื่อธนาคารสำหรับโอนเข้าบัญชี · เว้นว่าง (หรือไม่มีเลขบัญชี) = ไม่แสดงวิธีโอน
BANK_NAME=
# ชื่อบัญชี · เว้นว่าง = ใช้ PAYEE_NAME
BANK_ACCOUNT_NAME=
# เลขที่บัญชีบริษัท
BANK_ACCOUNT_NO=
# 1 = ลูกค้าเลือกชำระหน้างานกับช่างได้ · 0 = ปิด
PAY_ONSITE=1
# รายการชำระเงินที่สร้างใหม่ชำระได้กี่วัน
PAY_REQUEST_DAYS=7

# ── ผู้ให้บริการรับชำระออนไลน์ (เฟส 2: Omise) — เว้นว่างทั้งหมด = ปิด ──────────────────────
# Public key ของ Omise (ทดสอบด้วยคีย์ทดสอบ pkey_test_ ก่อนเสมอ)
OMISE_PUBLIC_KEY=
# Secret key ของ Omise (คีย์ทดสอบขึ้นต้น skey_test_) — ใส่ตัวนี้แล้วต้องใส่ OMISE_WEBHOOK_SECRET ด้วย
OMISE_SECRET_KEY=
# Webhook secret จากหน้า Webhooks ของ Omise (ปลายทาง https://โดเมน/api/webhooks/omise)
OMISE_WEBHOOK_SECRET=
# ที่อยู่ API ของ Omise (ไม่ต้องแก้)
OMISE_API=https://api.omise.co

# ── เฉพาะเครื่องนักพัฒนา (ห้ามใช้บนเซิร์ฟเวอร์จริง) ────────────────────────────────────────
# DEV=1 เปิดหน้า /__outbox ดูอีเมลที่ "ส่ง" (ใช้ไม่ได้เมื่อ NODE_ENV=production) · ใช้คู่ MAIL_TRANSPORT=memory
# DEV=
